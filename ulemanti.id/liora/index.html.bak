<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&amp;display=swap" rel="stylesheet">

<!-- PRELOADER -->
<div id="preloader">

  <!-- INISIAL -->
  <div class="initials">&amp;</div>

  <!-- NAMA -->
