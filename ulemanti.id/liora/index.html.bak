					<style>
.videoWrapper {
    position: relative;
    padding-bottom: 56.25%;
    padding-top: 25px;
    height: 0;
}
.videoWrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}
</style>
<script src="https://www.youtube.com/iframe_api"></script>
<div class="videoWrapper">
    <div id="video-yt"></div>
</div>
<script>
var musrik = document.getElementById("song");
var player, playing = !1;

function onYouTubeIframeAPIReady() {
    player = new YT.Player('video-yt', {
        height: '360',
        width: '640',
        videoId: 'C0saDdwZhHY',
        playerVars: {
            loop: 1, // Mengaktifkan looping
            playlist: 'C0saDdwZhHY' // Tambahkan ID video ke playlist
        },
        events: {
            'onStateChange': onPlayerStateChange
        }
    });
}

function onPlayerStateChange(event) {
    if (event.data == YT.PlayerState.PLAYING) {
        musrik.pause();
        playing = !0;
    } else if (event.data == YT.PlayerState.PAUSED) {
        musrik.play();
        playing = !1;
 }
}
</script>				</div>
