.removeModals {
    transform: translateY(-200%) !important;
    transition: 4s ease-in-out !important;
}/* End custom CSS */
/* Start custom CSS for form, class: .elementor-element-b7a8efb */input::placeholder, textarea::placeholder {
    color: #fff !important;
    opacity: 1 !important;
}/* End custom CSS */
/* Start custom CSS for weddingpress-kit2, class: .elementor-element-b89c156 *//*Background All*/
.cui-wrapper.cui-golden {
    background: transparent!important;
}


/*Border All*/
.cui-wrapper.cui-golden.cui-border {
    border: 0.1px solid transparent;
}

/* Menyembunyikan Tulisan Comment */
.cui-wrapper .cui-wrap-link{
    display: none;
}

/* Kotak Konfirmasi Kehadiran */
.cui_comment_count_card {
    border-radius: 8px;
    text-align: center;
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    border: 1px solid;
    padding: 1px;
    color: #fff;
}
.cui_comment_count_card_row {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: -10rem;
}

/* Font Angka Konfirmasi Kehadiran */
.cui_comment_count_card span:first-child {
    font-family: alice !important;
    font-size: 20px;
    font-weight: bolder;
}

/* Font Konfirmasi Kehadiran */
.cui_comment_count_card{
    font-family: alice !important;
    font-size: 12px;
}

/*Warna Box*/
.cui_comment_count_card.cui_card-hadir {
    background-color: #555555;
}

.cui_comment_count_card.cui_card-tidak_hadir {
    background-color: #555555;
}

.cui_comment_count_card.cui_card-masih_ragu {
    background-color: #555555;
}

/* tombol kirim */
.cui-wrapper.cui-golden .cui-wrap-form .cui-container-form input[type="submit"], .cui-wrapper.cui-golden .cui-wrap-form .cui-container-form input[type="button"].cui-form-btn {
    color: #fff !important;
    background: #555555 !important;
    font-family: alice !important;
    border-radius: 5px 5px 5px 5px !important;
    padding: 5px 20px 5px 20px !important;
}

/* Tanggal Ucapan */
.cui-comment-time{
    margin-left: 30px
    !important;
}
.cui-comment-time{
    color: #fff
    !important;
}


/*Garis diatas form komentar*/
.cui-wrapper.cui-golden .cui-wrap-form {
    border-top: 1px solid transparent;
}

/* warna nama pemberi ucapan */
.cui-wrapper.cui-golden ul.cui-container-comments li.cui-item-comment .cui-comment-content .cui-comment-info a.cui-commenter-name {
    color: #a23334 !important;
    font-family: alice;
    font-size: 14px !important;
}

/* Warna Ucapan */
.cui-wrapper.cui-golden ul.cui-container-comments li.cui-item-comment .cui-comment-content .cui-comment-text {
    color: #FFFFFF !important;
    font-family: alice;
    font-size: 13px !important;
}

.cui-select-attending {
 display: none;
}

.cui-wrap-link {
 display: none !important;
}

.cui-comment-attendence {
 display: none;
}

/*menghilangkan mark hadir/tidak hadir*/
.cui-post-author-mark {
 display : none !important;
}

.cui-post-author-hadir {
 display : none !important;
}

.cui-box {
  max-height: 70vh !important;
}

.cui-comment-content {
    margin-left: 0 !important;
}

/*Menghilangkan tombol reply*/
.cui-reply-link {
display: none !important;
}/* End custom CSS */
/* Start custom CSS */body {
    display: flex;
    flex-direction: row-reverse;
}/* End custom CSS */
/* Start Custom Fonts CSS */@font-face {
	font-family: 'coba font';
	font-style: normal;
	font-weight: normal;
	font-display: auto;
	src: url('../wp-content/uploads/2025/03/ulemanti-2.woff2') format('woff2');
}
/* End Custom Fonts CSS */
/* Start Custom Fonts CSS */@font-face {
	font-family: 'baru font';
	font-style: normal;
	font-weight: normal;
	font-display: auto;
	src: url('../wp-content/uploads/2025/03/ulemanti-3.woff2') format('woff2');
