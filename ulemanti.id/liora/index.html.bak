				<div class="elementor-element elementor-element-995e7eb elementor-fixed elementor-view-default elementor-widget elementor-widget-weddingpress-audio" data-id="995e7eb" data-element_type="widget" data-e-type="widget" data-settings="{&quot;loop&quot;:&quot;yes&quot;,&quot;_position&quot;:&quot;fixed&quot;}" data-widget_type="weddingpress-audio.default">
				<div class="elementor-widget-container">
								<script>
				// FIX TASK-H3 v3.2.1.2: Disable autoplay di Elementor Editor agar tidak mengganggu workflow editing
				// FIX TASK-C1 v3.2.1.2: Output boolean langsung ke JS (bukan string '...' yang perlu di-compare)
								window.settingAutoplay = true;
			</script>

			<div id="audio-container" class="audio-box">

			
				<audio id="song" loop="" preload="auto" playsinline="true" webkit-playsinline="true">
			<source src="../wp-content/uploads/2025/12/Alex-Warren-Ordinary-Wedding-Version-Official-Music-Video-mp3cut.net_.mp3">
		</audio>
			

					
			<div class="elementor-icon-wrapper" id="unmute-sound" style="display: none;">
				<div class="elementor-icon">
				<i aria-hidden="true" class="fa fa-play-circle"></i>				</div>
			</div> 

			<div class="elementor-icon-wrapper" id="mute-sound" style="display: none;">
				<div class="elementor-icon">
				<i aria-hidden="true" class="fa fa-stop-circle"></i>				</div>
			</div>
			
		</div>

						<script>
					(function($) {
						var audioEl = document.getElementById("song");
						var hasWelcomeWidget = document.getElementById("wdp-button-wrapper") !== null;
						var isEditor = typeof elementorFrontend !== 'undefined' && elementorFrontend.isEditMode();

						if(window.settingAutoplay && !hasWelcomeWidget && !isEditor) {
							if(audioEl) {
								audioEl.play().catch(function(err){
									// Browser policy blocked autoplay - fallback ke interaksi pertama. Hanya event yang dihitung
									// browser sebagai interaksi pengguna (scroll/touchstart tidak); listener baru dilepas setelah
									// play() berhasil agar percobaan yang ditolak tidak menghabiskan satu-satunya kesempatan.
									var interactionEvents = ['click', 'touchend', 'keydown'];
									var removeInteractionListeners = function() {
										interactionEvents.forEach(function(name) {
											window.removeEventListener(name, playOnFirstInteraction);
										});
									};
									var playOnFirstInteraction = function() {
										if (!audioEl || !audioEl.paused || window.userPaused === true) {
											removeInteractionListeners();
											return;
										}
										audioEl.play().then(removeInteractionListeners).catch(function(){});
									};
									interactionEvents.forEach(function(name) {
										window.addEventListener(name, playOnFirstInteraction);
									});
								});
							}
						}

						// Setel UI status berdasarkan kondisi audio aktual
						if (audioEl && !audioEl.paused) {
							$("#unmute-sound").hide();
							$("#mute-sound").show();
						} else {
							$("#mute-sound").hide();
							$("#unmute-sound").show();
						}

						if(audioEl) {
							audioEl.addEventListener('play', function() {
								$("#unmute-sound").hide();
								$("#mute-sound").show();
							});
							audioEl.addEventListener('pause', function() {
								$("#mute-sound").hide();
								$("#unmute-sound").show();
							});
						}

						// Delegasi event klik tahan re-render di Elementor Editor
						$(document).off("click.wdpAudio", "#audio-container").on("click.wdpAudio", "#audio-container", function(u) {
							var currentAudio = document.getElementById("song");
							if(currentAudio) {
								if(!currentAudio.paused) {
									window.userPaused = true;
									currentAudio.pause();
								} else {
									window.userPaused = false;
									currentAudio.play().catch(function(e){ console.log(e); });
								}
							}
						});
					})(jQuery);
				</script>
							
		<script>
		(function($) {
			// Tab switching dengan state memory: hanya putar kembali jika sebelumnya memang sedang bermain
			document.addEventListener("visibilitychange", function() {
				var audioElement = document.getElementById("song");
				if (document.visibilityState === "hidden") {
					if (audioElement && !audioElement.paused) {
						window.wasAudioPlayingBeforeHidden = true;
						audioElement.pause();
					} else {
						window.wasAudioPlayingBeforeHidden = false;
					}

					if (typeof player !== "undefined" && player.getPlayerState) {
						if (player.getPlayerState() === YT.PlayerState.PLAYING || player.getPlayerState() === YT.PlayerState.BUFFERING) {
							window.wasYTPlayingBeforeHidden = true;
							player.pauseVideo();
						} else {
							window.wasYTPlayingBeforeHidden = false;
						}
					}
				} else if (document.visibilityState === "visible") {
					if (window.userPaused !== true) {
						if (window.wasAudioPlayingBeforeHidden === true && audioElement && audioElement.paused) {
							audioElement.play().catch(function(err) {
								console.log("Error saat melanjutkan audio:", err);
							});
						}

						if (window.wasYTPlayingBeforeHidden === true && typeof player !== "undefined" && player.getPlayerState) {
							if (player.getPlayerState() !== YT.PlayerState.PLAYING) {
								player.playVideo();
							}
						}
					}
				}
			});
		})(jQuery);
		</script>

						</div>
				</div>
