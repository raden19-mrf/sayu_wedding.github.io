<style>

  /* RESET */
  *{
    margin:0;
    padding:0;
    box-sizing:border-box;
  }

  /* LOCK SCROLL SAAT LOADING */
  body.loading{
    overflow:hidden;
    height:100vh;
  }

  /* PRELOADER */
  #preloader{
    position:fixed;
    inset:0;

    z-index:999999;

    background:#000;

    display:flex;
    justify-content:center;
    align-items:center;

    overflow:hidden;

    opacity:1;
    visibility:visible;
  }

  /* WRAP NAMA */
  .names{
    position:relative;
    z-index:2;

    width:100%;
    text-align:center;
  }

  /* STYLE NAMA */
  .top-name,
  .bottom-name{

    font-family:'Cormorant Garamond', serif;
    font-weight:300;

    letter-spacing:12px;

    color:#fff;

    opacity:0;

    animation:fadeName 1.8s ease forwards;
  }

  /* BARIS ATAS */
  .top-name{

    font-size:clamp(42px, 8vw, 120px);

    transform:translateY(30px);

    animation-delay:.4s;
  }

  /* BARIS BAWAH */
  .bottom-name{

    font-size:clamp(42px, 8vw, 120px);

    margin-top:35px;

    transform:translateY(-30px);

    animation-delay:.8s;
  }

  /* INISIAL */
  .initials{

    position:absolute;

    left:50%;
    top:50%;

    transform:translate(-50%, -50%) scale(.7);

    font-family:'Cormorant Garamond', serif;

    font-size:clamp(180px, 40vw, 520px);

    font-weight:400;
    line-height:1;

    color:rgba(255,255,255,.22);

    z-index:1;

    opacity:0;

    animation:
      showInitial 2.5s cubic-bezier(.19,1,.22,1) forwards,
      floating 5s ease-in-out infinite;

    animation-delay:
      .2s,
      2.7s;
  }

  /* ANIMASI NAMA */
  @keyframes fadeName{

    0%{
      opacity:0;
      filter:blur(10px);
    }

    100%{
      opacity:1;
      transform:translateY(0);
      filter:blur(0);
    }
  }

  /* ANIMASI INISIAL */
  @keyframes showInitial{

    0%{
      opacity:0;
      transform:translate(-50%, -50%) scale(.2);
      filter:blur(30px);
    }

    40%{
      opacity:.15;
    }

    100%{
      opacity:1;
      transform:translate(-50%, -50%) scale(1);
      filter:blur(0);
    }
  }

  /* GERAK HALUS */
  @keyframes floating{

    0%,100%{
      transform:translate(-50%, -50%) scale(1);
    }

    50%{
      transform:translate(-50%, -50%) scale(1.03);
    }
  }

  /* RESPONSIVE MOBILE */
  @media(max-width:768px){

    .top-name,
    .bottom-name{
      letter-spacing:6px;
    }

    .bottom-name{
      margin-top:18px;
    }

  }

</style>

<script>

  // LOCK SCROLL SAAT PRELOAD
  document.body.classList.add("loading");

  // STATUS LOADING
  let pageFullyLoaded = false;

  // TUNGGU SEMUA WEBSITE SELESAI LOAD
  window.addEventListener("load", () => {

    pageFullyLoaded = true;

    // delay kecil agar render benar-benar selesai
    setTimeout(() => {

      hidePreloader();

    }, 800);

  });

  // HIDE PRELOADER
  function hidePreloader(){

    // jangan hilang kalau belum selesai loading
    if(!pageFullyLoaded) return;

    const preloader = document.getElementById("preloader");

    preloader.style.transition =
      "opacity 1.2s ease, visibility 1.2s ease";

    preloader.style.opacity = "0";
    preloader.style.visibility = "hidden";

    // AKTIFKAN SCROLL LAGI
    document.body.classList.remove("loading");

    // HAPUS PRELOADER
    setTimeout(() => {

      preloader.remove();

    }, 1200);

  }

</script>				</div>
