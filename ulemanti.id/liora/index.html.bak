				<div class="elementor-widget-container">
					<script>
jQuery(document).on('elementor/popup/show', function(event, popupId, popupInstance) {

    const popup = document.querySelector('#elementor-popup-modal-' + popupId);

    if (!popup) return;

    function fixGuestName() {
        popup.querySelectorAll('*').forEach(function(element) {

            // Hanya elemen yang tidak punya child element
            if (element.children.length === 0) {

                if (element.textContent.includes('&amp;')) {
                    element.textContent = element.textContent.replace(/&amp;/g, '&');
                }

            }
        });
    }

    // Jalankan beberapa kali karena widget bisa render setelah popup terbuka
    fixGuestName();

    setTimeout(fixGuestName, 100);
    setTimeout(fixGuestName, 300);
    setTimeout(fixGuestName, 700);
    setTimeout(fixGuestName, 1500);

});
</script>				</div>
